{
  "project": "Fantasy Convoy MVP",
  "document_version": "0.1",
  "engine": "Godot 4.x",
  "asset_pack_version": "1.0",
  "palette": {
    "paper": "#F3EFE4",
    "primary_ink": "#1A1A1A",
    "light_line": "#B7B2A8",
    "medium_gray": "#77736C",
    "white": "#FFFFFF"
  },
  "spec_derived": [
    "paper-and-ink style",
    "black, white, and gray only",
    "off-white paper background",
    "8 percent static paper grain",
    "two line-frame variants for important world objects",
    "entity silhouettes and selection symbols",
    "HUD region placement",
    "five placeholder sound cues"
  ],
  "implementation_assumptions": [
    "World sprite source canvases use 256x256 view boxes.",
    "UI icons use 96x96 view boxes.",
    "Buttons use 240x88 view boxes.",
    "Screen mockups use 1920x1080.",
    "Role monograms are optional identifiers layered over the required defender silhouette.",
    "Typography is not defined by the specification; mockups use a generic serif stack and no font files are included."
  ],
  "recommended_animation": {
    "hand_drawn_frame_period_seconds": 0.15,
    "world_asset_frame_sequence": [
      "_a",
      "_b"
    ],
    "paper_grain_motion": "static"
  },
