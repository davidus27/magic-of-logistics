[layer_names]

2d_physics/layer_1="cargo"
2d_physics/layer_2="defender"
2d_physics/layer_3="enemy"
2d_physics/layer_4="road_wall"
2d_physics/layer_5="map_wall"
2d_physics/layer_6="barrier"
2d_physics/layer_7="projectile_friendly"
2d_physics/layer_8="projectile_enemy"
2d_physics/layer_9="terrain"
2d_physics/layer_10="trigger"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.952941, 0.937255, 0.894118, 1)
